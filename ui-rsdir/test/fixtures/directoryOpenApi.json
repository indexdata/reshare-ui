{
  "openapi": "3.0.0",
  "x-host-profiles": {
    "Alma": {
      "catalogConfig": {
        "holdingsFormat": {
          "opac": {
            "availabilityRule": "availableNow",
            "requireLocalLocation": true,
            "includeItemId": true,
            "includeItemLoanPolicy": true,
            "allCirculations": true
          }
        }
      },
      "lmsConfig": {}
    },
    "FOLIO": {
      "catalogConfig": {
        "holdingsFormat": {
          "opac": {
            "availabilityRule": "availableNow",
            "requireLocalLocation": true,
            "includeItemId": true,
            "includeItemLoanPolicy": true,
            "allCirculations": true,
            "includeTemporaryLocation": true
          }
        }
      },
      "lmsConfig": {}
    },
    "Generic": {
      "catalogConfig": {},
      "lmsConfig": {
        "ncipNamespaceEnabled": true,
        "bibIdNormalization": "none",
        "requestItemRequestType": "Page",
        "requestItemRequestScopeType": "Item",
        "requestItemBibIdCode": "SYSNUMBER",
        "requestItemPickupLocationEnabled": true,
        "lookupUserEnabled": true,
        "acceptItemEnabled": true,
        "checkInItemEnabled": true,
        "checkOutItemEnabled": true,
        "requestItemEnabled": true
      }
    },
    "Koha": {
      "catalogConfig": {
        "holdingsFormat": {
          "marc": {
            "mainField": "952",
            "locationSubField": "b",
            "callNumberSubField": "o",
            "availability": [
              {
                "operator": "equals",
                "subField": "7",
                "value": "0"
              },
              {
                "operator": "absent",
                "subField": "q"
              }
            ],
            "shelvingLocationSubField": "c"
          }
        }
      },
      "lmsConfig": {
        "ncipNamespaceEnabled": false
      }
    },
    "Sierra": {
      "catalogConfig": {
        "holdingsFormat": {
          "opac": {
            "availabilityRule": "publicNote",
            "availablePublicNotes": [
              "AVAILABLE",
              "CHECK SHELVES",
              "CHECK SHELF"
            ],
            "shelvingLocationSource": "localLocation",
            "includeItemId": false,
            "includeItemLoanPolicy": false
          }
        }
      },
      "lmsConfig": {
        "requestItemRequestType": "Hold",
        "requestItemRequestScopeType": "Title",
        "bibIdNormalization": "sierra"
      }
    }
  },
  "components": {
    "schemas": {
      "IllConfig": {
        "type": "object",
        "properties": {
          "loanConditions": {
            "type": "array",
            "description": "Configured loan condition codes and descriptions.",
            "items": {
              "$ref": "#/components/schemas/IllConfigCodeDescription"
            },
            "x-default-data": {
              "LibraryUseOnly": "Use in library only",
              "WatchLibraryUseOnly": "Watch over use in library only",
              "NoReproduction": "No reproduction",
              "SignatureRequired": "Signature required",
              "SpecCollSupervReq": "Special collections supervision required"
            }
          },
          "availableCopyrightTypes": {
            "type": "array",
            "description": "Configured codes and descriptions.",
            "items": {
              "$ref": "#/components/schemas/IllConfigCodeDescription"
            },
            "x-default-data": {
              "AU-CopyRCatS183ComW": "Copyright Act S183 - Commonwealth (Australia)",
              "AU-CopyRCatS183State": "Copyright Act S183 - State (Australia)",
              "AU-CopyrightActS49": "Copyright Act S49 (Australia)",
              "AU-CopyrightActS50-1": "Copyright Act S50 (Australia)",
              "AU-CopyrightActS50-7A": "Copyright Act S50 A (Australia)",
              "AU-CopyrightCleared": "Copyright Cleared (Australia)",
              "AU-GenBus": "General Business (Australia)",
              "NZ-CopyrightActS54": "Copyright Act S54 (New Zealand)",
              "NZ-CopyrightActS55": "Copyright Act S55 (New Zealand)",
              "Other": "Other types of copyright compliance. Use Note in ServiceInfo for details.",
              "UK-CopyRFeePaid": "Copyright Fee Paid (UK)",
              "UK-FairDealing": "Fair Dealing (UK)",
              "US-CCG": "CCG (US)",
              "US-CCL": "CCL (US code)"
            }
          },
          "unfilledReasons": {
            "type": "array",
            "description": "Configured codes and descriptions.",
            "items": {
              "$ref": "#/components/schemas/IllConfigCodeDescription"
            },
            "x-default-data": {
              "NonCirculating": "Non-circulating (e.g. handbook)",
              "NotAvailableForILL": "Not available for ILL",
              "NotHeld": "Not held",
              "NotOnShelf": "Not on shelf",
              "PolicyProblem": "Policy problem",
              "PoorCondition": "Poor condition"
            }
          },
          "cancellationReasons": {
            "type": "array",
            "description": "Configured codes and descriptions.",
            "items": {
              "$ref": "#/components/schemas/IllConfigCodeDescription"
            },
            "x-default-data": {
              "DuplicateRequest": "Duplicate request",
              "NotFound": "Not found as cited",
              "LocallyAvailable": "Requested item is locally available",
              "AccountInvalid": "User account is invalid",
              "UserRequest": "User requested cancellation"
            }
          },
          "defaultCopyrightType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IllConfigCodeDescription"
              },
              {
                "type": "null"
              }
            ],
            "description": "The default copyright type to use for copy requests",
            "x-default-data": {
              "AU-CopyRCatS183ComW": "Copyright Act S183 - Commonwealth (Australia)",
              "AU-CopyRCatS183State": "Copyright Act S183 - State (Australia)",
              "AU-CopyrightActS49": "Copyright Act S49 (Australia)",
              "AU-CopyrightActS50-1": "Copyright Act S50 (Australia)",
              "AU-CopyrightActS50-7A": "Copyright Act S50 A (Australia)",
              "AU-CopyrightCleared": "Copyright Cleared (Australia)",
              "AU-GenBus": "General Business (Australia)",
              "NZ-CopyrightActS54": "Copyright Act S54 (New Zealand)",
              "NZ-CopyrightActS55": "Copyright Act S55 (New Zealand)",
              "Other": "Other types of copyright compliance. Use Note in ServiceInfo for details.",
              "UK-CopyRFeePaid": "Copyright Fee Paid (UK)",
              "UK-FairDealing": "Fair Dealing (UK)",
              "US-CCG": "CCG (US)",
              "US-CCL": "CCL (US code)"
            }
          }
        }
      },
      "IllConfigCodeDescription": {
        "type": "object",
        "description": "A configured ILL code and its default description.",
        "additionalProperties": false,
        "required": [
          "code",
          "defaultDesc"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "defaultDesc": {
            "type": "string"
          }
        }
      }
    }
  }
}
