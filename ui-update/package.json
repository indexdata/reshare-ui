{
  "name": "@projectreshare/update",
  "version": "2.0.0",
  "description": "Quickly change the status of items. Part of the ReShare project.",
  "repository": {
    "type": "git",
    "url": "https://github.com/indexdata/reshare-ui",
    "directory": "ui-update"
  },
  "main": "src/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "start": "stripes serve",
    "build": "stripes build --output ./output",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@projectreshare/stripes-reshare": "~3.0.0",
    "final-form": "^4.2.0",
    "react-final-form": "^6.3.0"
  },
  "peerDependencies": {
    "@folio/stripes": "^9.0.0 || ^10.0.0",
    "react": "*",
    "react-intl": "^6.4.7 || ^7.0.0",
    "react-query": "^3.9.0",
    "react-router-dom": "^5.2.0"
  },
  "stripes": {
    "actsAs": [
      "app",
      "handler"
    ],
    "handlerName": "eventHandler",
    "displayName": "ui-update.meta.title",
    "route": "/update",
    "stripesDeps": [
      "@projectreshare/stripes-reshare"
    ],
    "icons": [
      {
        "name": "app",
        "alt": "Update patron requests",
        "title": "Update"
      }
    ],
    "okapiInterfaces": {
      "crosslink-broker": "1.0"
    },
    "permissionSets": [
      {
        "permissionName": "module.update.enabled",
        "displayName": "UI: update module is enabled",
        "visible": true
      }
    ]
  }
}
